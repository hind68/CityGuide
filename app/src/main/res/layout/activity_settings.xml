<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="@color/deep_navy_blue"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textProfileSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/card_background"
            android:padding="20dp"
            android:textColor="@color/deep_navy_blue"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Default city"
            android:textColor="@color/gold"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerDefaultCity"
            android:layout_width="match_parent"
            android:layout_height="54dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Default language"
            android:textColor="@color/gold"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerDefaultLanguage"
            android:layout_width="match_parent"
            android:layout_height="54dp" />

        <Switch
            android:id="@+id/switchDarkMode"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:text="Dark mode placeholder"
            android:textColor="@color/deep_navy_blue" />

        <Button
            android:id="@+id/buttonSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/btn_primary"
            android:text="Save Settings"
            android:textAllCaps="false"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/buttonLogout"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/btn_secondary"
            android:text="Logout"
            android:textAllCaps="false"
            android:textColor="@color/deep_navy_blue" />

        <Button
            android:id="@+id/buttonSignIn"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/btn_secondary"
            android:text="Sign In"
            android:textAllCaps="false"
            android:textColor="@color/deep_navy_blue" />
    </LinearLayout>
</ScrollView>
