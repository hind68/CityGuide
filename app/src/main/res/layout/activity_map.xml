<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:contentDescription="Map"
            android:src="@drawable/ic_map" />

        <TextView
            android:id="@+id/textMapTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:textColor="@color/deep_navy_blue"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textMapCoordinates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/olive_shadow"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/card_background"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:padding="18dp"
            android:text="Map preview placeholder. TODO: enable Google Maps dependency and API key, then replace this panel with a SupportMapFragment and markers from SQLite."
            android:textColor="@color/deep_navy_blue"
            android:textSize="15sp" />

        <Button
            android:id="@+id/buttonOpenExternalMap"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/btn_primary"
            android:text="Open External Map"
            android:textAllCaps="false"
            android:textColor="@color/white" />
    </LinearLayout>
</FrameLayout>
