<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/home_card"
    android:elevation="4dp"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/textInitial"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/btn_secondary"
        android:gravity="center"
        android:textColor="@color/deep_navy_blue"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textItemTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/deep_navy_blue"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textItemSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/gold"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textItemDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/olive_shadow"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/textItemMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/deep_navy_blue"
        android:textSize="13sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/buttonPrimary"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/btn_primary"
        android:textAllCaps="false"
        android:textColor="@color/white" />
</LinearLayout>
