<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingTop="10dp"
            android:paddingRight="20dp"
            android:paddingBottom="30dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textGreeting"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/deep_navy_blue"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/actionProfile"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/onboarding_icon_frame"
                    android:padding="8dp"
                    android:scaleType="center"
                    android:src="@drawable/ic_account" />
            </LinearLayout>

            <TextView
                android:id="@+id/actionSearch"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/input_background"
                android:drawableLeft="@drawable/ic_map"
                android:drawablePadding="12dp"
                android:gravity="center_vertical"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:text="@string/home_search"
                android:textColor="@color/olive_shadow"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="@string/explore_by_category"
                android:textColor="@color/deep_navy_blue"
                android:textSize="25sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/categoryRestaurants"
                    style="@style/HomeCategoryStyle">
                    <ImageView style="@style/HomeCategoryIconStyle" android:src="@drawable/ic_restaurant" />
                    <TextView style="@style/HomeCategoryTextStyle" android:text="@string/restaurants" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/categoryCafes"
                    style="@style/HomeCategoryStyle">
                    <ImageView style="@style/HomeCategoryIconStyle" android:src="@drawable/ic_cafe" />
                    <TextView style="@style/HomeCategoryTextStyle" android:text="@string/cafes" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/categoryMonuments"
                    style="@style/HomeCategoryStyle">
                    <ImageView style="@style/HomeCategoryIconStyle" android:src="@drawable/ic_monument" />
                    <TextView style="@style/HomeCategoryTextStyle" android:text="@string/monuments" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/categoryLeisure"
                    style="@style/HomeCategoryStyle">
                    <ImageView style="@style/HomeCategoryIconStyle" android:src="@drawable/ic_leisure" />
                    <TextView style="@style/HomeCategoryTextStyle" android:text="@string/activities" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/handpicked_morocco"
                android:textColor="@color/deep_navy_blue"
                android:textSize="25sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="194dp"
                android:layout_marginTop="14dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingBottom="14dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/collectionRooftops"
                        style="@style/HomeWideImageCardStyle">
                        <ImageView style="@style/HomeCardImageStyle" android:src="@drawable/place_koutoubia" />
                        <View style="@style/HomeDarkOverlayStyle" />
                        <TextView style="@style/HomeImageTitleStyle" android:text="@string/marrakech_rooftops" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/collectionHiddenMedina"
                        style="@style/HomeWideImageCardStyle">
                        <ImageView style="@style/HomeCardImageStyle" android:src="@drawable/place_chefchaouen" />
                        <View style="@style/HomeDarkOverlayStyle" />
                        <TextView style="@style/HomeImageTitleStyle" android:text="@string/hidden_medina_treasures" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/collectionFood"
                        style="@style/HomeWideImageCardStyle">
                        <ImageView style="@style/HomeCardImageStyle" android:src="@drawable/experience_food_tour" />
                        <View style="@style/HomeDarkOverlayStyle" />
                        <TextView style="@style/HomeImageTitleStyle" android:text="@string/food_tours_flavors" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/collectionCrafts"
                        style="@style/HomeWideImageCardStyle">
                        <ImageView style="@style/HomeCardImageStyle" android:src="@drawable/place_zellige_workshop_fes" />
                        <View style="@style/HomeDarkOverlayStyle" />
                        <TextView style="@style/HomeImageTitleStyle" android:text="@string/craft_workshops" />
                    </FrameLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/textRemoteSuggestionsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/remote_suggestions"
                android:textColor="@color/deep_navy_blue"
                android:textSize="25sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="138dp"
                android:layout_marginTop="14dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingBottom="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/remoteSuggestionsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/remoteSuggestionOne"
                        style="@style/HomeGuideCardStyle"
                        android:layout_width="190dp"
                        android:layout_marginRight="14dp"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/textRemoteTitleOne"
                            style="@style/HomeSmallTitleStyle"
                            android:layout_width="match_parent"
                            android:text="@string/remote_loading" />

                        <TextView
                            android:id="@+id/textRemoteSubtitleOne"
                            style="@style/HomeSmallSubtitleStyle"
                            android:layout_width="match_parent" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/remoteSuggestionTwo"
                        style="@style/HomeGuideCardStyle"
                        android:layout_width="190dp"
                        android:layout_marginRight="14dp"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/textRemoteTitleTwo"
                            style="@style/HomeSmallTitleStyle"
                            android:layout_width="match_parent"
                            android:text="@string/remote_loading" />

                        <TextView
                            android:id="@+id/textRemoteSubtitleTwo"
                            style="@style/HomeSmallSubtitleStyle"
                            android:layout_width="match_parent" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/remoteSuggestionThree"
                        style="@style/HomeGuideCardStyle"
                        android:layout_width="190dp"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/textRemoteTitleThree"
                            style="@style/HomeSmallTitleStyle"
                            android:layout_width="match_parent"
                            android:text="@string/remote_loading" />

                        <TextView
                            android:id="@+id/textRemoteSubtitleThree"
                            style="@style/HomeSmallSubtitleStyle"
                            android:layout_width="match_parent" />
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/trending_now"
                android:textColor="@color/deep_navy_blue"
                android:textSize="25sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="238dp"
                android:layout_marginTop="14dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingTop="4dp"
                android:paddingBottom="14dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/trendingPlace"
                        style="@style/HomeTrendingCardStyle">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/place_oudayas" />

                        <View style="@style/HomeDarkOverlayStyle" />

                        <ImageView
                            android:id="@+id/favoriteTrendingPlace"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="12dp"
                            android:background="@drawable/home_favorite_chip"
                            android:padding="10dp"
                            android:src="@drawable/ic_favorite"
                            android:tint="@color/deep_navy_blue" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:background="@drawable/home_trending_panel"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView style="@style/HomeTrendingTitleStyle" android:text="Oudayas Kasbah" />
                            <TextView style="@style/HomeTrendingSubtitleStyle" android:text="Rabat - Ocean views and blue alleys" />
                        </LinearLayout>
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/trendingCafe"
                        style="@style/HomeTrendingCardStyle">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/place_cafe_clock_fes" />

                        <View style="@style/HomeDarkOverlayStyle" />

                        <ImageView
                            android:id="@+id/favoriteTrendingCafe"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="12dp"
                            android:background="@drawable/home_favorite_chip"
                            android:padding="10dp"
                            android:src="@drawable/ic_favorite"
                            android:tint="@color/deep_navy_blue" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:background="@drawable/home_trending_panel"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView style="@style/HomeTrendingTitleStyle" android:text="Cafe Clock" />
                            <TextView style="@style/HomeTrendingSubtitleStyle" android:text="Fes - Rooftop cafe and cultural nights" />
                        </LinearLayout>
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/trendingMajorelle"
                        style="@style/HomeTrendingCardStyle">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/place_majorelle" />

                        <View style="@style/HomeDarkOverlayStyle" />

                        <ImageView
                            android:id="@+id/favoriteTrendingMajorelle"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="12dp"
                            android:background="@drawable/home_favorite_chip"
                            android:padding="10dp"
                            android:src="@drawable/ic_favorite"
                            android:tint="@color/deep_navy_blue" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:background="@drawable/home_trending_panel"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView style="@style/HomeTrendingTitleStyle" android:text="Majorelle Garden" />
                            <TextView style="@style/HomeTrendingSubtitleStyle" android:text="Marrakech - Blue villa and gardens" />
                        </LinearLayout>
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/trendingAgafay"
                        style="@style/HomeTrendingCardStyle">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/place_agafay_desert" />

                        <View style="@style/HomeDarkOverlayStyle" />

                        <ImageView
                            android:id="@+id/favoriteTrendingAgafay"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="12dp"
                            android:background="@drawable/home_favorite_chip"
                            android:padding="10dp"
                            android:src="@drawable/ic_favorite"
                            android:tint="@color/deep_navy_blue" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:background="@drawable/home_trending_panel"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView style="@style/HomeTrendingTitleStyle" android:text="Agafay Desert" />
                            <TextView style="@style/HomeTrendingSubtitleStyle" android:text="Marrakech - Desert calm and pools" />
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/available_local_guides"
                android:textColor="@color/deep_navy_blue"
                android:textSize="25sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingTop="4dp"
                android:paddingBottom="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/guideAmina"
                    style="@style/HomeGuideCardStyle"
                    android:layout_marginRight="14dp">
                    <ImageView style="@style/HomeGuideImageStyle" android:src="@drawable/guide_amina" />
                    <TextView style="@style/HomeSmallTitleStyle" android:text="Amina E." />
                    <TextView style="@style/HomeSmallSubtitleStyle" android:text="Medina heritage" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/guideOmar"
                    style="@style/HomeGuideCardStyle"
                    android:layout_marginRight="14dp">
                    <ImageView style="@style/HomeGuideImageStyle" android:src="@drawable/guide_omar" />
                    <TextView style="@style/HomeSmallTitleStyle" android:text="Omar C." />
                    <TextView style="@style/HomeSmallSubtitleStyle" android:text="Urban culture" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/guideNadia"
                    style="@style/HomeGuideCardStyle"
                    android:layout_marginRight="14dp">
                    <ImageView style="@style/HomeGuideImageStyle" android:src="@drawable/guide_nadia" />
                    <TextView style="@style/HomeSmallTitleStyle" android:text="Nadia A." />
                    <TextView style="@style/HomeSmallSubtitleStyle" android:text="Photo walks" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/guideYoussef"
                    style="@style/HomeGuideCardStyle">
                    <ImageView style="@style/HomeGuideImageStyle" android:src="@drawable/guide_youssef" />
                    <TextView style="@style/HomeSmallTitleStyle" android:text="Youssef B." />
                    <TextView style="@style/HomeSmallSubtitleStyle" android:text="Souks and food" />
                </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/recently_viewed"
                android:textColor="@color/deep_navy_blue"
                android:textSize="25sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/recentPlace"
                android:layout_width="match_parent"
                android:layout_height="132dp"
                android:layout_marginBottom="10dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/home_card"
                android:clipToOutline="true"
                android:elevation="5dp"
                android:padding="0dp">

                <ImageView
                    android:id="@+id/imageRecent"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/place_chefchaouen" />

                <View style="@style/HomeDarkOverlayStyle" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:id="@+id/textRecentTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/start_exploring"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/textRecentSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/recent_empty_home"
                        android:textColor="#EAF3FF"
                        android:textSize="14sp" />
                </LinearLayout>
            </FrameLayout>

            <Button
                android:id="@+id/buttonExploreMap"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/btn_primary"
                android:text="@string/explore_map"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
