<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.CityGuide.Button" parent="@android:style/Widget.Button">
        <item name="android:backgroundTint">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="HomeCardStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:background">@drawable/home_card</item>
        <item name="android:elevation">5dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">20dp</item>
    </style>

    <style name="HomeCardIconStyle">
        <item name="android:layout_width">34dp</item>
        <item name="android:layout_height">34dp</item>
    </style>

    <style name="HomeCardTitleStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textColor">@color/deep_navy_blue</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="HomeCardBodyStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:textColor">@color/olive_shadow</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="HomeCategoryStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">100dp</item>
        <item name="android:layout_marginLeft">3dp</item>
        <item name="android:layout_marginRight">3dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="HomeCategoryIconStyle">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:background">@drawable/category_icon_bg</item>
        <item name="android:padding">14dp</item>
        <item name="android:scaleType">centerInside</item>
    </style>

    <style name="HomeCategoryTextStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/deep_navy_blue</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="HomeWideImageCardStyle">
        <item name="android:layout_width">250dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_marginRight">14dp</item>
        <item name="android:background">@drawable/home_card</item>
        <item name="android:clipToOutline">true</item>
        <item name="android:elevation">6dp</item>
    </style>

    <style name="HomeCardImageStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:scaleType">centerCrop</item>
    </style>

    <style name="HomeDarkOverlayStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">#66000000</item>
    </style>

    <style name="HomeImageTitleStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">bottom</item>
        <item name="android:padding">16dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="HomeTrendingCardStyle">
        <item name="android:layout_width">272dp</item>
        <item name="android:layout_height">220dp</item>
        <item name="android:layout_marginRight">14dp</item>
        <item name="android:background">@drawable/home_card</item>
        <item name="android:clipToOutline">true</item>
        <item name="android:elevation">6dp</item>
    </style>

    <style name="HomeTrendingTitleStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/deep_navy_blue</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="HomeTrendingSubtitleStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:textColor">@color/olive_shadow</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="HomeSmallPlaceCardStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">190dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/home_card</item>
        <item name="android:elevation">5dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">10dp</item>
    </style>

    <style name="HomeSmallImageStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">105dp</item>
        <item name="android:background">@drawable/home_image_round</item>
        <item name="android:clipToOutline">true</item>
        <item name="android:elevation">2dp</item>
        <item name="android:scaleType">centerCrop</item>
    </style>

    <style name="HomeSmallTitleStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/deep_navy_blue</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="HomeSmallSubtitleStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/olive_shadow</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="HomeGuideCardStyle">
        <item name="android:layout_width">96dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:elevation">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">0dp</item>
    </style>

    <style name="HomeAvatarStyle">
        <item name="android:layout_width">62dp</item>
        <item name="android:layout_height">62dp</item>
        <item name="android:background">@drawable/onboarding_icon_frame</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/deep_navy_blue</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="HomeGuideImageStyle">
        <item name="android:layout_width">78dp</item>
        <item name="android:layout_height">78dp</item>
        <item name="android:background">@drawable/avatar_circle</item>
        <item name="android:clipToOutline">true</item>
        <item name="android:scaleType">centerCrop</item>
    </style>
</resources>
